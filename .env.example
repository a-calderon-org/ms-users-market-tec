PORT=8080
SERVICE_NAME=ms-users

# Choose exactly one: local (alias in-memory), sql-dev, sql-appservice.
# sql-appservice uses system-assigned Managed Identity only; server/database have no defaults.
SPRING_PROFILES_ACTIVE=local
# sql-dev uses ActiveDirectoryDefault (Azure CLI for development), never SQL credentials.
USERS_SQL_SERVER=sql-markettec-dev.database.windows.net
USERS_SQL_DATABASE=sqldb-ms-users-dev
USERS_SQL_PORT=1433
USERS_SQL_POOL_SIZE=3

# Internal loopback management listener; review any exposure change.
MANAGEMENT_PORT=9091
