PORT=8080
SERVICE_NAME=ms-users

# Choose exactly one: local (alias in-memory), sql-dev. No implicit SQL fallback.
SPRING_PROFILES_ACTIVE=local
# sql-dev uses ActiveDirectoryDefault (Azure CLI for development), never SQL credentials.
USERS_SQL_SERVER=sql-markettec-dev.database.windows.net
USERS_SQL_DATABASE=sqldb-ms-users-dev
USERS_SQL_PORT=1433
USERS_SQL_POOL_SIZE=3
