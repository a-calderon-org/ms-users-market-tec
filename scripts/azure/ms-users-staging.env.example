# ms-users Azure staging — operator configuration (no secrets).
# Sourced by bash. Copy outside the repository or to scripts/azure/.env (ignored by .gitignore) and fill the
# operator-chosen names. Values marked "verified" were observed read-only with az CLI on
# 2026-11-08; re-check them with `ms-users-staging.sh check` before executing anything.

# Verified: subscription "Azure for Students" that holds the plan and Azure SQL server.
# It is NOT the az CLI default subscription on the operator machine; every command passes it.
AZ_SUBSCRIPTION_ID=26db4383-add6-4e47-9ca1-3b208853ac17
AZ_LOCATION=canadacentral

# Verified: existing Linux Free (F1) plan, 0 apps.
APP_RESOURCE_GROUP=acalderon-TEC
APP_SERVICE_PLAN=ASP-acalderonTEC-9c69

# Verified: Entra-only Azure SQL server and serverless database.
SQL_RESOURCE_GROUP=a-calderon-org
SQL_SERVER_NAME=sql-markettec-dev
SQL_DATABASE_NAME=sqldb-ms-users-dev

# Operator-chosen (not created yet). Web app name is globally unique and becomes
# <WEBAPP_NAME>.azurewebsites.net; the system-assigned identity takes the same name in SQL.
WEBAPP_NAME=
# Operator-chosen (not created yet). 3-24 chars, globally unique.
KEY_VAULT_NAME=
KEY_VAULT_RESOURCE_GROUP=acalderon-TEC

# Operator-chosen CSRF key id ([A-Za-z0-9_-]{1,32}). Not secret; the key material lives
# only in Key Vault secret users-csrf-keys-json.
USERS_CSRF_ACTIVE_KID=

# F1 plan: 1 GB shared by the plan. Heap + metaspace bounded; C1-only JIT saves CPU minutes.
JAVA_OPTS="-Xms64m -Xmx384m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=48m -Xss512k -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError"

# Local folder for built JARs, kept outside the repository so rollback artifacts survive `mvn clean`.
ARTIFACT_DIR="${HOME}/.cache/markettec/ms-users-artifacts"
